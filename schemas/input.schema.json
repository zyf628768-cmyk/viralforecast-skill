{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/viralforecast/input.schema.json",
  "title": "ViralForecast analysis request (CLI flags map to these fields)",
  "type": "object",
  "required": ["video", "platform"],
  "additionalProperties": false,
  "properties": {
    "video": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "caption": {"type": "string"},
    "platform": {"enum": ["tiktok", "youtube-shorts", "instagram-reels", "douyin", "kuaishou", "xiaohongshu", "bilibili"]},
    "cover": {"type": "string"},
    "transcript": {"type": "string"},
    "rules": {"type": "string"},
    "understand": {"type": "boolean"},
    "asr": {"type": "boolean"},
    "models_dir": {"type": "string"},
    "language": {"type": "string"},
    "semantic_labels": {"type": "string"},
    "trends_csv": {"type": "string"},
    "as_of": {"type": "string"},
    "trend_days": {"type": "integer", "minimum": 1, "maximum": 30},
    "min_similarity": {"type": "number", "minimum": 0, "maximum": 1},
    "exclude_account": {"type": "string"},
    "transcriber": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"}
  }
}
